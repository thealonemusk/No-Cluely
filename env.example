# AI provider: gemini | claude | cursor  (only the selected provider is used)
LLM_PROVIDER=gemini

# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (used when LLM_PROVIDER=claude)
# Get a key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# Cursor (used when LLM_PROVIDER=cursor)
# Get a key from: https://cursor.com/dashboard
CURSOR_API_KEY=
# CURSOR_MODEL=grok-4.6

# Speech Recognition Configuration
# Choose one provider: azure or whisper
SPEECH_PROVIDER=whisper

# Optional: Azure Speech Services Configuration
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=your_azure_region_here

# Optional: Local faster-whisper configuration
# Requires a Python venv with faster-whisper, for example:
#   python -m venv .venv-whisper
#   .venv-whisper/Scripts/pip install faster-whisper   # Windows
#   .venv-whisper/bin/pip install faster-whisper       # macOS/Linux
# WHISPER_COMMAND should be the venv Python, not a whisper CLI.
WHISPER_COMMAND=
# Optional: where Whisper model weights are stored. Leave unset to use a stable
# app-data folder (recommended). Set an ABSOLUTE path to override; a relative
# path is ignored because it cannot be resolved reliably in packaged builds.
# WHISPER_MODEL_DIR=
WHISPER_MODEL=base
WHISPER_LANGUAGE=en
WHISPER_SEGMENT_MS=4000
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=1
WHISPER_PYTHON=
WHISPER_CAPTURE_MODE=vad
WHISPER_RESPONSE_TARGET=both
WHISPER_MANUAL_MAX_MS=30000
WHISPER_GPU_IDLE_MS=30000
